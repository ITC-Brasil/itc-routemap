# PostgreSQL
POSTGRES_PASSWORD=senha_segura_aqui

# Better Auth
BETTER_AUTH_SECRET=gere_com_openssl_rand_base64_32
BETTER_AUTH_URL=http://seu-servidor.com

# Google OAuth (login social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed do primeiro admin (usado por `npm run db:seed`, não pelo runtime)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=

# Google APIs (server-side)
# - GOOGLE_MAPS_SERVER_API_KEY: Routes Matrix, Routes Single e Geocoding
# - GOOGLE_SERVICE_ACCOUNT_BASE64: conta de serviço em Base64 (JSON),
#   usada pela sincronização Google Sheets e pelo Firebase Admin
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_SERVICE_ACCOUNT_BASE64=

# Google Maps (browser) — BUILD-TIME: embutida no bundle durante o
# `docker compose build` (vira build arg do Dockerfile). Mudou a chave?
# Precisa rebuildar a imagem, não basta reiniciar o container.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_ENABLED=true
